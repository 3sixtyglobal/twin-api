{
	"name": "@twin.org/api-server-fastify",
	"version": "0.0.3-next.53",
	"description": "Fastify web server integration for exposing API routes with consistent runtime behaviour.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-api.git",
		"directory": "packages/api-server-fastify"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@fastify/compress": "9.0.0",
		"@fastify/cors": "11.2.0",
		"@twin.org/api-core": "0.0.3-next.53",
		"@twin.org/api-models": "0.0.3-next.53",
		"@twin.org/api-processors": "0.0.3-next.53",
		"@twin.org/context": "next",
		"@twin.org/core": "next",
		"@twin.org/logging-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/web": "next",
		"fastify": "5.8.5",
		"socket.io": "4.8.3"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@vitest/coverage-v8": "4.1.9",
		"@types/node": "26.0.0",
		"copyfiles": "2.4.1",
		"rimraf": "6.1.3",
		"socket.io-client": "4.8.3",
		"ts-patch": "4.0.1",
		"nodemon": "3.1.14",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.9"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"api"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-api/issues"
	},
	"homepage": "https://twindev.org"
}
